{
  "uid": "expenseflow-ops",
  "title": "ExpenseFlow Ops",
  "timezone": "Asia/Kolkata",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Queue size by level",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "expenseflow_approval_queue_size", "legendFormat": "{{level}}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Oldest pending age (hours)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "expenseflow_oldest_pending_approval_seconds / 3600", "legendFormat": "{{level}}" } ],
      "fieldConfig": { "defaults": { "unit": "h", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 48 }, { "color": "red", "value": 72 } ] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "timeseries", "title": "API p95 latency",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/api/.*\"}[5m])))", "legendFormat": "{{uri}}" } ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4, "type": "timeseries", "title": "Policy outcomes by rule (rate)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (rule, outcome) (rate(expenseflow_policy_outcome_total[15m]))", "legendFormat": "{{rule}} {{outcome}}" } ]
    },
    {
      "id": 5, "type": "stat", "title": "Claims submitted (1 h)",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(increase(expenseflow_claims_submitted_total[1h]))" } ]
    },
    {
      "id": 6, "type": "stat", "title": "5xx rate",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))" } ]
    }
  ]
}
