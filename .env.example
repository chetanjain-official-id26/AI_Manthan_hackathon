# Copy to .env (repo root) and change the values. Never commit .env.
# docker compose loads this file into the db, backend, seed and grafana containers.

# Database (the backend reads POSTGRES_USER / POSTGRES_PASSWORD too)
POSTGRES_DB=expenseflow
POSTGRES_USER=expenseflow
POSTGRES_PASSWORD=change-me-local-only

# HS256 signing key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_TTL_MINUTES=60

# Demo login endpoints are enabled only with the "demo" profile
SPRING_PROFILES_ACTIVE=demo

# Frontend origin allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sample audit: leave empty in prod (SecureRandom); set a number for a reproducible demo
SAMPLE_AUDIT_SEED=42

JAVA_OPTS=-Xms256m -Xmx768m

# Grafana admin password (user: admin)
GF_SECURITY_ADMIN_PASSWORD=change-me-local-only
